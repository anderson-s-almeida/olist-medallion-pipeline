table _Medidas_html
	lineageTag: 25687e9a-2550-4f3b-8a55-5a494c45cc39

	measure 'TML Cabecalho' =
			
			-- meses válidos da seleção (regra dos 10% para descartar meses incompletos)
			VAR _baseMeses =
			    ADDCOLUMNS (
			        VALUES ( dim_data[ano_mes] ),
			        "@ord", CALCULATE ( MIN ( dim_data[sk_data] ) ),
			        "@ped", [Pedidos],
			        "@rec", [Receita],
			        "@cli", [Clientes Únicos]
			    )
			VAR _maxPed = MAXX ( _baseMeses, [@ped] )
			VAR _meses = FILTER ( _baseMeses, [@ped] >= _maxPed * 0.1 )
			-- último mês válido define o ano de referência e até que mês acumular
			VAR _oU = MAXX ( _meses, [@ord] )
			VAR _anoU = INT ( _oU / 10000 )
			VAR _mesU = INT ( MOD ( _oU, 10000 ) / 100 )
			VAR _filtroMes = ISFILTERED ( dim_data[mes] ) || ISFILTERED ( dim_data[ano_mes] )
			-- acumulado do ano (YTD) e mesmo período do ano anterior
			VAR _recA = CALCULATE ( [Receita], dim_data[ano] = _anoU, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _recB = CALCULATE ( [Receita], dim_data[ano] = _anoU - 1, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _pedA = CALCULATE ( [Pedidos], dim_data[ano] = _anoU, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _pedB = CALCULATE ( [Pedidos], dim_data[ano] = _anoU - 1, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _cliA = CALCULATE ( [Clientes Únicos], dim_data[ano] = _anoU, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _cliB = CALCULATE ( [Clientes Únicos], dim_data[ano] = _anoU - 1, KEEPFILTERS ( dim_data[mes] <= _mesU ) )
			VAR _tkA = DIVIDE ( _recA, _pedA )
			VAR _tkB = DIVIDE ( _recB, _pedB )
			VAR _vR = DIVIDE ( _recA - _recB, _recB )
			VAR _vP = DIVIDE ( _pedA - _pedB, _pedB )
			VAR _vT = DIVIDE ( _tkA - _tkB, _tkB )
			VAR _vC = DIVIDE ( _cliA - _cliB, _cliB )
			-- textos de período
			VAR _mesTxt = FORMAT ( DATE ( _anoU, _mesU, 1 ), "mmm" )
			VAR _periodo = IF ( _filtroMes, _anoU & " · meses selec.", _anoU & " até " & _mesTxt )
			VAR _base = IF ( _filtroMes, "vs " & ( _anoU - 1 ), "vs jan–" & _mesTxt & "/" & ( _anoU - 1 ) )
			VAR _txR = IF ( ISBLANK ( _vR ), "<div class='lbl'>sem base de comparação</div>", IF ( _vR >= 0, "<div class='up'>▲ ", "<div class='dn'>▼ " ) & FORMAT ( ABS ( _vR ), "0.0%" ) & " " & _base & "</div>" )
			VAR _txP = IF ( ISBLANK ( _vP ), "<div class='lbl'>sem base de comparação</div>", IF ( _vP >= 0, "<div class='up'>▲ ", "<div class='dn'>▼ " ) & FORMAT ( ABS ( _vP ), "0.0%" ) & " " & _base & "</div>" )
			VAR _txT = IF ( ISBLANK ( _vT ), "<div class='lbl'>sem base de comparação</div>", IF ( _vT >= 0, "<div class='up'>▲ ", "<div class='dn'>▼ " ) & FORMAT ( ABS ( _vT ), "0.0%" ) & " " & _base & "</div>" )
			VAR _txC = IF ( ISBLANK ( _vC ), "<div class='lbl'>sem base de comparação</div>", IF ( _vC >= 0, "<div class='up'>▲ ", "<div class='dn'>▼ " ) & FORMAT ( ABS ( _vC ), "0.0%" ) & " " & _base & "</div>" )
			VAR _recTxt = IF ( _recA >= 1000000, "R$ " & FORMAT ( _recA / 1000000, "0.0" ) & " Mi", "R$ " & FORMAT ( _recA / 1000, "#,##0" ) & " mil" )
			-- mini gráficos: últimos 12 meses válidos
			VAR _m12 = ADDCOLUMNS ( TOPN ( 12, _meses, [@ord], DESC ), "@tk", DIVIDE ( [@rec], [@ped] ) )
			VAR _n = COUNTROWS ( _m12 )
			VAR _i = ADDCOLUMNS ( _m12, "@i", RANKX ( _m12, [@ord], , ASC, DENSE ) )
			VAR _rMax = MAXX ( _i, [@rec] )
			VAR _rMin = MINX ( _i, [@rec] )
			VAR _pMax = MAXX ( _i, [@ped] )
			VAR _pMin = MINX ( _i, [@ped] )
			VAR _tMax = MAXX ( _i, [@tk] )
			VAR _tMin = MINX ( _i, [@tk] )
			VAR _cMax = MAXX ( _i, [@cli] )
			VAR _cMin = MINX ( _i, [@cli] )
			VAR _spR = CONCATENATEX ( _i, FORMAT ( DIVIDE ( ( [@i] - 1 ) * 70, MAX ( _n - 1, 1 ) ), "0" ) & "," & FORMAT ( 22 - DIVIDE ( [@rec] - _rMin, _rMax - _rMin ) * 18, "0" ), " ", [@i], ASC )
			VAR _spP = CONCATENATEX ( _i, FORMAT ( DIVIDE ( ( [@i] - 1 ) * 70, MAX ( _n - 1, 1 ) ), "0" ) & "," & FORMAT ( 22 - DIVIDE ( [@ped] - _pMin, _pMax - _pMin ) * 18, "0" ), " ", [@i], ASC )
			VAR _spT = CONCATENATEX ( _i, FORMAT ( DIVIDE ( ( [@i] - 1 ) * 70, MAX ( _n - 1, 1 ) ), "0" ) & "," & FORMAT ( 22 - DIVIDE ( [@tk] - _tMin, _tMax - _tMin ) * 18, "0" ), " ", [@i], ASC )
			VAR _spC = CONCATENATEX ( _i, FORMAT ( DIVIDE ( ( [@i] - 1 ) * 70, MAX ( _n - 1, 1 ) ), "0" ) & "," & FORMAT ( 22 - DIVIDE ( [@cli] - _cMin, _cMax - _cMin ) * 18, "0" ), " ", [@i], ASC )
			-- período total do subtítulo
			VAR _ini = CALCULATE ( MIN ( dim_data[data] ), fato_vendas )
			VAR _fim = CALCULATE ( MAX ( dim_data[data] ), fato_vendas )
			RETURN
			    "<div class='card header'>
			        <div>
			            <div class='title'>Olist | Dashboard de Vendas</div>
			            <div class='sub'>E-commerce brasileiro · " & FORMAT ( _ini, "mm/yyyy" ) & " a " & FORMAT ( _fim, "mm/yyyy" ) & "</div>
			            <div class='sub' style='color:#a78bfa'>Indicadores: " & _periodo & "</div>
			        </div>
			        <div class='pills'>
			            <div class='pill kp'><div><div class='lbl'>Receita</div><div class='v'>" & _recTxt & "</div>" & _txR & "</div>
			                <svg width='70' height='24'><polyline points='" & _spR & "' fill='none' stroke='#22d3ee' stroke-width='2'/></svg></div>
			            <div class='pill kp'><div><div class='lbl'>Pedidos</div><div class='v'>" & FORMAT ( _pedA, "#,##0" ) & "</div>" & _txP & "</div>
			                <svg width='70' height='24'><polyline points='" & _spP & "' fill='none' stroke='#60a5fa' stroke-width='2'/></svg></div>
			            <div class='pill kp'><div><div class='lbl'>Ticket médio</div><div class='v'>" & FORMAT ( _tkA, "R$ #,##0.00" ) & "</div>" & _txT & "</div>
			                <svg width='70' height='24'><polyline points='" & _spT & "' fill='none' stroke='#a78bfa' stroke-width='2'/></svg></div>
			            <div class='pill kp'><div><div class='lbl'>Clientes únicos</div><div class='v'>" & FORMAT ( _cliA, "#,##0" ) & "</div>" & _txC & "</div>
			                <svg width='70' height='24'><polyline points='" & _spC & "' fill='none' stroke='#34d399' stroke-width='2'/></svg></div>
			        </div>
			    </div>"
		lineageTag: 5da9f0c4-b352-4f15-babe-dc1fa6e76514

	measure 'HTML Dashboard' =
			
			[HTML Estilo]
			    & "<div class='dash'>"
			    & [TML Cabecalho]
			    & [HTML Destaque]
			    & [HTML Grafico Area]
			    & [HTML Top Categorias]
			    & [HTML Gauge]
			    & [HTML Minis]
			    & [HTML Mapa UF]
			    & "</div>"
		lineageTag: e931820c-1ec4-41db-b853-71680ad341b5

	measure 'HTML Destaque' =
			
			VAR _top =
			    TOPN ( 1, ADDCOLUMNS ( VALUES ( dim_produto[categoria] ), "@v", [Receita] ), [@v], DESC )
			VAR _cat = CONCATENATEX ( _top, dim_produto[categoria] )
			VAR _rec = MAXX ( _top, [@v] )
			VAR _ped = CALCULATE ( [Pedidos], dim_produto[categoria] = _cat )
			VAR _part = DIVIDE ( _rec, [Receita] )
			VAR _nota = CALCULATE ( [Nota Média], dim_produto[categoria] = _cat )
			RETURN
			    "<div class='card' style='grid-area:d'>
			        <div class='lbl'>Categoria destaque</div>
			        <div class='dest'>
			            <div class='icon'>📦</div>
			            <div>
			                <div style='font-size:16px;font-weight:700;color:#ffffff;text-transform:capitalize;margin-bottom:4px'>" & SUBSTITUTE ( _cat, "_", " " ) & "</div>
			                <div class='kpi'><div class='kdot'>💰</div><div><div class='lbl'>Receita</div><div class='kv'>R$ " & FORMAT ( _rec / 1000, "#,##0" ) & " mil</div></div></div>
			                <div class='kpi'><div class='kdot'>🛒</div><div><div class='lbl'>Pedidos</div><div class='kv'>" & FORMAT ( _ped, "#,##0" ) & "</div></div></div>
			                <div class='kpi'><div class='kdot'>📊</div><div><div class='lbl'>Participação</div><div class='kv'>" & FORMAT ( _part, "0.0%" ) & "</div></div></div>
			                <div class='kpi'><div class='kdot'>⭐</div><div><div class='lbl'>Nota média</div><div class='kv'>" & FORMAT ( _nota, "0.00" ) & "</div></div></div>
			            </div>
			        </div>
			    </div>"
		lineageTag: c6b093f2-fc12-4d0d-8b6c-af8c1babff60

	measure 'HTML Estilo' =
			
			"<style>
			.dash{font-family:'Segoe UI',sans-serif;color:#e2e8f0;padding:16px 18px;box-sizing:border-box;height:100vh;
			 background:radial-gradient(circle at 15% 0%,#1e1b4b 0%,transparent 45%),radial-gradient(circle at 95% 100%,#0c3a5e 0%,transparent 45%),#070b1a;
			 display:grid;gap:16px;grid-template-columns:minmax(0,0.75fr) minmax(0,1.35fr) minmax(0,1fr);grid-template-rows:78px 46px 1fr 1fr 0.55fr;
			 grid-template-areas:'h h h' 'f f f' 'd a m' 't g m' 't s m';}
			.card{background:linear-gradient(160deg,rgba(30,41,82,.85),rgba(12,17,40,.92));border:1px solid rgba(96,165,250,.25);border-radius:16px;
			 box-shadow:0 0 18px rgba(59,130,246,.18),inset 0 0 14px rgba(139,92,246,.08);padding:14px 18px;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;min-height:0;}
			.header{grid-area:h;flex-direction:row !important;justify-content:space-between;align-items:center;gap:12px;padding:8px 18px !important;}
			.title{font-size:20px;font-weight:700;color:#ffffff;}
			.sub{font-size:12px;color:#94a3b8;margin-top:2px;}
			.pills{display:flex;gap:10px;flex-wrap:wrap;}
			.pill{background:rgba(15,23,42,.85);border:1px solid rgba(139,92,246,.35);border-radius:12px;padding:4px 16px;text-align:center;box-shadow:0 0 10px rgba(139,92,246,.15);}
			.pill .lbl{font-size:10px;}
			.pill .v{font-size:17px;font-weight:700;color:#ffffff;}
			.lbl{font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;}
			.ctitle{font-size:15px;font-weight:600;color:#ffffff;margin-bottom:8px;}
			.dest{display:flex;gap:22px;align-items:center;flex:1;}
			.icon{font-size:70px;width:130px;height:130px;border-radius:22px;display:flex;align-items:center;justify-content:center;
			 background:rgba(15,23,42,.85);border:1px solid rgba(96,165,250,.35);box-shadow:0 0 22px rgba(59,130,246,.35);}
			.kpi{display:flex;align-items:center;gap:10px;margin:7px 0;}
			.kdot{width:26px;height:26px;border-radius:50%;background:rgba(59,130,246,.18);border:1px solid rgba(96,165,250,.35);display:flex;align-items:center;justify-content:center;font-size:13px;}
			.kv{font-size:19px;font-weight:700;color:#38bdf8;}
			.bar-row{display:flex;align-items:center;gap:10px;margin:0;font-size:13px;color:#cbd5e1;}
			.bar-name{width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			.bar-bg{flex:1;height:12px;background:#1e293b;border-radius:5px;}
			.bar{height:12px;border-radius:6px;background:linear-gradient(90deg,#3b82f6,#a855f7);box-shadow:0 0 8px rgba(139,92,246,.6);}
			.bar-v{width:90px;text-align:right;font-weight:600;color:#ffffff;}
			.minis{grid-area:s;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
			.mini{text-align:center;padding:12px 6px;display:flex;flex-direction:column;justify-content:center;}
			.mini .mv{font-size:28px;font-weight:700;color:#38bdf8;margin-top:4px;}
			.mini .mi{font-size:20px;margin-top:2px;}
			.leg{display:flex;justify-content:center;gap:16px;font-size:12px;color:#94a3b8;margin-top:6px;}
			.leg span{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:4px;vertical-align:middle;}
			.kp{display:flex;align-items:center;gap:10px;text-align:left;padding:6px 14px !important;}
			.kp .v{font-size:18px;}
			.up{color:#34d399;font-size:11px;font-weight:600;}
			.dn{color:#f87171;font-size:11px;font-weight:600;}
			.split{display:flex;gap:10px;flex:1;min-height:0;}
			.split>div{flex:1;display:flex;flex-direction:column;min-height:0;}
			.nrow{display:flex;align-items:center;gap:8px;font-size:12px;color:#cbd5e1;}
			.nrow .bar-bg{height:10px;}
			.nrow .bar{height:10px;}
			.mini .sub2{font-size:11px;color:#94a3b8;margin-top:2px;}
			.rank{position:absolute;right:0;bottom:4px;width:160px;background:rgba(11,16,35,.88);border:1px solid rgba(139,92,246,.35);border-radius:10px;padding:8px 10px;box-shadow:0 0 12px rgba(139,92,246,.2);}
			.rk{display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:3px 0;border-bottom:1px solid rgba(96,165,250,.12);}
			</style>"
		lineageTag: 8846cfb4-c9b4-4ec7-8782-647ea9e3036d

	measure 'HTML Gauge' =
			
			VAR _p = [% Entregas no Prazo]
			VAR _dash = FORMAT ( _p * 440, "0" )
			VAR _tot = CALCULATE ( [Pedidos], NOT ISBLANK ( fato_vendas[nota_avaliacao] ) )
			VAR _notas =
			    ADDCOLUMNS (
			        GENERATESERIES ( 1, 5, 1 ),
			        "@pct",
			            VAR _k = [Value]
			            RETURN DIVIDE ( CALCULATE ( [Pedidos], fato_vendas[nota_avaliacao] = _k ), _tot )
			    )
			VAR _pmax = MAXX ( _notas, [@pct] )
			VAR _rows =
			    CONCATENATEX (
			        _notas,
			        VAR _c = SWITCH ( [Value], 5, "#a855f7", 4, "#818cf8", 3, "#22d3ee", 2, "#f9a8d4", "#f472b6" )
			        RETURN
			            "<div class='nrow'>
			                <div style='width:34px'>" & [Value] & " ⭐</div>
			                <div class='bar-bg' style='flex:1'><div class='bar' style='width:" & FORMAT ( DIVIDE ( [@pct], _pmax ) * 100, "0" ) & "%;background:" & _c & ";box-shadow:0 0 8px " & _c & "'></div></div>
			                <div style='width:52px;text-align:right;font-weight:600;color:#ffffff'>" & FORMAT ( [@pct], "0.0%" ) & "</div>
			            </div>",
			        "", [Value], DESC
			    )
			RETURN
			    "<div class='card' style='grid-area:g'>
			        <div class='split'>
			            <div style='text-align:center'>
			                <div class='ctitle'>Entregas no prazo</div>
			                <svg viewBox='0 0 200 200' style='flex:1;min-height:0;width:100%'>
			                    <defs>
			                        <linearGradient id='gGauge' x1='0' y1='0' x2='1' y2='1'>
			                            <stop offset='0%' stop-color='#22d3ee'/>
			                            <stop offset='100%' stop-color='#a855f7'/>
			                        </linearGradient>
			                    </defs>
			                    <circle cx='100' cy='100' r='70' fill='none' stroke='#1e293b' stroke-width='16'/>
			                    <circle cx='100' cy='100' r='70' fill='none' stroke='#3b82f6' stroke-opacity='0.25' stroke-width='26'
			                            stroke-dasharray='" & _dash & " 440' transform='rotate(-90 100 100)'/>
			                    <circle cx='100' cy='100' r='70' fill='none' stroke='url(#gGauge)' stroke-width='14' stroke-linecap='round'
			                            stroke-dasharray='" & _dash & " 440' transform='rotate(-90 100 100)'/>
			                    <text x='100' y='104' text-anchor='middle' font-size='28' font-weight='700' fill='#ffffff'>" & FORMAT ( _p, "0.0%" ) & "</text>
			                    <text x='100' y='126' text-anchor='middle' font-size='11' fill='#94a3b8'>dos pedidos</text>
			                </svg>
			            </div>
			            <div style='border-left:1px solid rgba(96,165,250,.2);padding-left:14px'>
			                <div class='ctitle'>Distribuição das notas</div>
			                <div style='flex:1;display:flex;flex-direction:column;justify-content:space-around'>" & _rows & "</div>
			                <div style='font-size:11px;color:#94a3b8;margin-top:4px'>Nota média <b style='color:#38bdf8'>" & FORMAT ( [Nota Média], "0.00" ) & "</b></div>
			            </div>
			        </div>
			    </div>"
		lineageTag: 59c13c4b-36ac-4f9a-ba8c-54d5a6693a07

	measure 'HTML Grafico Area' = ```
			
			VAR _esp = 48        -- largura (px) reservada para cada mês
			VAR _H = 200
			VAR _px = 22
			VAR _py = 12
			VAR _base =
			    ADDCOLUMNS (
			        VALUES ( dim_data[ano_mes] ),
			        "@ord", CALCULATE ( MIN ( dim_data[sk_data] ) ),
			        "@v", [Receita],
			        "@ped", [Pedidos],
			        "@pv", [Receita Ano Anterior]
			    )
			VAR _maxPed = MAXX ( _base, [@ped] )
			VAR _t = FILTER ( _base, [@ped] >= _maxPed * 0.1 )
			VAR _n = COUNTROWS ( _t )
			VAR _W = MAX ( _n * _esp + 2 * _px, 640 )
			VAR _max = MAX ( MAXX ( _t, [@v] ), MAXX ( _t, [@pv] ) )
			VAR _baseY = _H - _py - 22
			VAR _alt = _H - 2 * _py - 34
			VAR _idx = ADDCOLUMNS ( _t, "@i", RANKX ( _t, [@ord], , ASC, DENSE ) )
			VAR _xy =
			    ADDCOLUMNS (
			        _idx,
			        "@x", _px + DIVIDE ( ( [@i] - 1 ) * ( _W - 2 * _px ), MAX ( _n - 1, 1 ) ),
			        "@y", _baseY - DIVIDE ( [@v], _max ) * _alt,
			        "@yp", IF ( ISBLANK ( [@pv] ), BLANK (), _baseY - DIVIDE ( [@pv], _max ) * _alt )
			    )
			VAR _line = CONCATENATEX ( _xy, FORMAT ( [@x], "0" ) & "," & FORMAT ( [@y], "0" ), " ", [@i], ASC )
			VAR _pline = CONCATENATEX ( FILTER ( _xy, NOT ISBLANK ( [@yp] ) ), FORMAT ( [@x], "0" ) & "," & FORMAT ( [@yp], "0" ), " ", [@i], ASC )
			VAR _area = _px & "," & _baseY & " " & _line & " " & ( _W - _px ) & "," & _baseY
			VAR _grid =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 3, 1 ),
			        VAR _gy = FORMAT ( _py + [Value] * ( _baseY - _py ) / 3, "0" )
			        RETURN "<line x1='" & _px & "' x2='" & ( _W - _px ) & "' y1='" & _gy & "' y2='" & _gy & "' stroke='#1e293b' stroke-width='1'/>",
			        ""
			    )
			-- rótulo de todos os meses
			VAR _labels =
			    CONCATENATEX (
			        _xy,
			        "<text x='" & FORMAT ( [@x], "0" ) & "' y='" & ( _H - 6 ) & "' font-size='11' fill='#94a3b8' text-anchor='middle'>"
			            & RIGHT ( dim_data[ano_mes], 2 ) & "/" & MID ( dim_data[ano_mes], 3, 2 ) & "</text>",
			        "", [@i], ASC
			    )
			-- rótulo do ano no fim de cada linha + divisória em cada janeiro
			VAR _ultI = MAXX ( _xy, [@i] )
			VAR _ult = FILTER ( _xy, [@i] = _ultI )
			VAR _anoFim = MAXX ( _ult, VALUE ( LEFT ( dim_data[ano_mes], 4 ) ) )
			VAR _xU = MAXX ( _ult, [@x] )
			VAR _yU = MAXX ( _ult, [@y] )
			VAR _ypU = MAXX ( _ult, [@yp] )
			VAR _rotAnos =
			    "<text x='" & FORMAT ( _xU - 8, "0" ) & "' y='" & FORMAT ( _yU - 10, "0" ) & "' text-anchor='end' font-size='12' font-weight='700' fill='#c4b5fd' stroke='#0b1023' stroke-width='3' paint-order='stroke'>" & _anoFim & "</text>"
			        & IF (
			            ISBLANK ( _ypU ), "",
			            "<text x='" & FORMAT ( _xU - 8, "0" ) & "' y='" & FORMAT ( _ypU + 18, "0" ) & "' text-anchor='end' font-size='12' font-weight='700' fill='#f472b6' stroke='#0b1023' stroke-width='3' paint-order='stroke'>" & ( _anoFim - 1 ) & "</text>"
			        )
			VAR _janeiros =
			    CONCATENATEX (
			        FILTER ( _xy, RIGHT ( dim_data[ano_mes], 2 ) = "01" && [@i] > 1 ),
			        VAR _jx = FORMAT ( [@x] - DIVIDE ( _W - 2 * _px, MAX ( _n - 1, 1 ) ) / 2, "0" )
			        RETURN
			            "<line x1='" & _jx & "' x2='" & _jx & "' y1='" & _py & "' y2='" & _baseY & "' stroke='#475569' stroke-width='1' stroke-dasharray='2 4'/>"
			                & "<text x='" & FORMAT ( _jx + 6, "0" ) & "' y='" & ( _py + 10 ) & "' font-size='11' font-weight='700' fill='#64748b'>" & LEFT ( dim_data[ano_mes], 4 ) & "</text>",
			        ""
			    )
			-- pontos com dica: a área sensível é a coluna inteira do mês (não só a bolinha)
			VAR _passo = DIVIDE ( _W - 2 * _px, MAX ( _n - 1, 1 ) )
			VAR _dots =
			    CONCATENATEX (
			        _xy,
			        "<g class='pt'><title>" & RIGHT ( dim_data[ano_mes], 2 ) & "/" & LEFT ( dim_data[ano_mes], 4 ) & ": R$ " & FORMAT ( [@v], "#,##0" )
			            & IF ( ISBLANK ( [@pv] ), "", " | ano anterior: R$ " & FORMAT ( [@pv], "#,##0" ) ) & "</title>"
			            & "<rect x='" & FORMAT ( [@x] - _passo / 2, "0" ) & "' y='0' width='" & FORMAT ( _passo, "0" ) & "' height='" & _baseY & "' fill='transparent'/>"
			            & "<line class='guia' x1='" & FORMAT ( [@x], "0" ) & "' x2='" & FORMAT ( [@x], "0" ) & "' y1='" & _py & "' y2='" & _baseY & "' stroke='#a78bfa' stroke-width='1' stroke-dasharray='3 3'/>"
			            & "<circle class='dot' cx='" & FORMAT ( [@x], "0" ) & "' cy='" & FORMAT ( [@y], "0" ) & "' r='4' fill='#0b1023' stroke='#a78bfa' stroke-width='2'/></g>",
			        "", [@i], ASC
			    )
			RETURN
			    "<style>
			    .scrollx{flex:1;min-height:0;overflow-x:auto;overflow-y:hidden;direction:rtl;}
			    .scrollx>svg{direction:ltr;display:block;}
			    .scrollx::-webkit-scrollbar{height:6px;}
			    .scrollx::-webkit-scrollbar-track{background:#111a3a;border-radius:3px;}
			    .scrollx::-webkit-scrollbar-thumb{background:linear-gradient(90deg,#3b82f6,#a855f7);border-radius:3px;}
			    .pt .guia{opacity:0;}
			    .pt:hover .guia{opacity:.7;}
			    .pt:hover .dot{r:6;fill:#a78bfa;stroke:#ffffff;}
			    </style>
			    <div class='card' style='grid-area:a'>
			        <div style='display:flex;justify-content:space-between;align-items:baseline'>
			            <div class='ctitle'>Receita mês a mês</div>
			            <div style='font-size:11px;color:#94a3b8'><span style='color:#22d3ee'>━</span> Receita do mês &nbsp; <span style='color:#f472b6'>┅</span> Mesmo mês no ano anterior</div>
			        </div>"
			        & IF (
			            _n < 2,
			            "<div class='sub'>Selecione um período com pelo menos 2 meses.</div>",
			            "<div class='scrollx'>
			            <svg viewBox='0 0 " & _W & " " & _H & "' width='" & _W & "' height='" & _H & "' style='min-width:100%'>
			                <defs>
			                    <linearGradient id='gArea' x1='0' y1='0' x2='0' y2='1'>
			                        <stop offset='0%' stop-color='#3b82f6' stop-opacity='0.6'/>
			                        <stop offset='100%' stop-color='#a855f7' stop-opacity='0.02'/>
			                    </linearGradient>
			                    <linearGradient id='gLine' x1='0' y1='0' x2='1' y2='0'>
			                        <stop offset='0%' stop-color='#22d3ee'/>
			                        <stop offset='100%' stop-color='#a855f7'/>
			                    </linearGradient>
			                </defs>"
			                & _grid
			                & "<polygon points='" & _area & "' fill='url(#gArea)'/>"
			                & IF ( ISBLANK ( _pline ), "", "<polyline points='" & _pline & "' fill='none' stroke='#f472b6' stroke-width='2' stroke-dasharray='6 5' opacity='0.85'/>" )
			                & "<polyline points='" & _line & "' fill='none' stroke='url(#gLine)' stroke-width='3' stroke-linejoin='round'/>"
			                & _janeiros & _dots & _labels & _rotAnos &
			            "</svg>
			            </div>"
			        )
			        & "</div>"
			
			```
		lineageTag: 5a0493d8-f850-4354-b8e4-c5d302dbb235

	measure 'HTML Mapa UF' =
			
			VAR _estados =
			    DATATABLE (
			        "Sigla", STRING, "X", INTEGER, "Y", INTEGER, "Regiao", STRING, "Forma", STRING,
			        { { "SP", 254, 283, "Sudeste", "M212 286L220 280L230 262L239 257L250 259L250 262L252 261L253 263L254 261L267 259L269 262L271 274L276 275L274 284L276 286L276 290L286 288L291 286L293 288L297 288L296 290L291 292L292 296L285 298L285 300L281 299L270 304L262 310L259 314L258 311L255 311L256 308L248 307L249 304L245 299L245 293L242 289L235 289L222 284L212 286Z" },
			            { "MA", 293, 107, "Nordeste", "M329 83L329 86L325 90L322 90L317 98L319 108L316 113L316 117L318 119L317 124L312 125L306 124L299 131L291 133L286 146L287 152L286 161L282 159L278 155L280 152L274 147L277 141L280 141L281 136L275 137L268 128L270 126L271 121L271 112L262 107L258 109L270 101L275 94L287 65L286 67L289 66L290 68L291 67L292 70L293 68L293 72L298 69L299 72L301 73L300 78L302 76L303 78L299 88L302 85L303 81L306 79L303 83L305 84L310 78L312 81L314 79L325 84L328 84L325 82L329 83Z" },
			            { "PA", 212, 97, "Norte", "M233 60L232 65L225 69L230 60L233 60ZM236 57L235 57L237 54L239 55L236 57ZM251 53L251 55L248 56L251 53ZM243 51L250 50L248 52L245 55L242 54L243 51ZM242 49L241 50L242 49ZM245 48L242 50L242 49L245 48ZM250 71L239 72L237 69L237 65L239 66L237 65L237 61L238 57L241 55L253 56L262 58L257 69L256 68L257 69L254 68L254 71L250 71ZM285 67L283 77L275 94L270 101L258 109L264 112L263 115L258 123L253 125L251 132L253 134L252 140L244 150L242 155L176 150L168 144L167 138L158 123L179 77L161 67L155 60L153 41L158 41L160 38L163 39L172 33L183 35L184 28L186 30L194 28L197 31L196 36L210 41L219 63L226 66L224 68L217 70L222 70L222 72L237 64L235 66L238 72L237 74L238 73L241 75L245 73L247 75L253 72L248 81L256 71L256 72L259 68L261 71L261 67L263 66L261 66L266 61L275 61L275 63L278 61L281 65L285 64L285 67Z" },
			            { "SC", 236, 333, "Sul", "M254 321L253 323L252 322L255 333L253 344L251 346L251 345L251 348L243 355L238 354L242 346L235 345L231 339L221 333L206 332L207 323L228 327L229 324L235 321L242 321L245 323L254 321Z" },
			            { "BA", 328, 184, "Nordeste", "M339 243L335 236L337 232L339 231L344 224L340 220L329 219L325 212L322 212L314 207L306 207L305 206L306 203L301 202L283 211L285 202L281 197L283 187L281 179L284 177L282 176L284 174L279 171L282 165L287 161L295 167L304 164L308 158L307 152L314 152L320 154L335 145L337 147L340 154L353 144L363 149L368 161L368 167L364 168L363 170L367 177L372 176L364 188L359 192L359 189L357 188L356 190L358 192L354 195L354 221L349 235L350 241L344 247L339 243Z" },
			            { "AP", 225, 39, "Norte", "M226 66L219 63L210 41L196 36L196 34L196 29L203 33L211 30L215 32L219 28L221 22L229 11L230 12L230 9L231 10L233 17L234 14L234 20L238 32L240 36L246 37L246 40L237 52L232 55L226 66Z" },
			            { "MS", 196, 262, "Centro-Oeste", "M203 299L202 300L198 298L191 299L189 286L186 282L181 280L177 282L166 280L167 269L164 261L167 259L164 256L168 249L169 240L168 236L173 236L177 231L182 230L192 235L197 233L203 234L207 230L204 237L213 238L214 242L216 242L215 245L234 253L233 260L227 266L223 276L208 288L203 299Z" },
			            { "MG", 295, 245, "Sudeste", "M233 260L234 253L240 246L248 244L249 245L253 242L264 244L270 240L270 235L268 234L271 229L269 224L270 219L275 217L275 209L278 209L279 206L283 207L283 211L301 202L306 203L305 206L306 207L314 207L322 212L325 212L329 219L340 220L344 224L336 234L335 236L339 243L332 242L333 244L330 246L331 251L328 251L331 255L330 258L326 265L321 267L316 280L283 287L281 290L276 290L276 286L274 284L276 275L271 274L269 262L267 259L254 261L254 263L252 261L250 262L250 259L239 257L233 260Z" },
			            { "GO", 248, 218, "Centro-Oeste", "M270 222L269 224L271 229L268 234L270 235L270 240L264 244L253 242L249 245L248 244L240 246L234 254L215 245L216 242L213 241L212 231L218 223L217 221L225 216L227 210L233 206L239 187L243 181L242 187L250 190L254 184L256 191L263 188L267 191L268 189L269 191L282 186L283 187L281 195L285 202L283 207L279 206L278 209L275 209L275 217L271 219L269 214L262 213L262 219L270 219L270 222Z" },
			            { "RS", 210, 358, "Sul", "M243 355L233 372L221 383L221 380L228 376L235 365L234 363L231 366L228 361L229 365L227 372L222 374L220 380L221 383L216 393L209 399L209 394L212 390L215 390L216 383L211 388L206 382L195 374L190 370L186 372L186 369L179 362L176 364L172 363L186 346L189 345L188 343L204 332L213 331L227 336L235 345L242 346L238 354L243 355Z" },
			            { "TO", 262, 158, "Norte", "M286 161L287 161L282 165L279 171L284 174L282 176L284 177L281 179L282 186L269 191L268 189L267 191L263 188L256 191L254 184L250 190L247 189L242 187L243 181L238 185L237 172L238 163L244 150L249 144L253 137L253 134L251 132L253 125L261 119L264 112L258 109L262 107L267 108L271 112L272 118L270 126L268 128L275 137L280 136L281 137L280 141L277 141L274 147L280 152L278 155L282 159L286 161Z" },
			            { "PI", 316, 131, "Nordeste", "M287 161L286 161L287 152L286 146L291 133L299 131L306 124L312 125L317 124L318 119L316 117L316 113L319 108L317 98L322 90L327 88L329 83L334 85L333 90L336 98L335 106L339 122L343 126L340 132L341 139L329 148L327 151L320 154L311 151L307 152L308 158L303 164L295 167L287 161Z" },
			            { "AL", 380, 156, "Nordeste", "M396 150L382 166L377 161L366 155L364 153L369 148L377 154L383 153L387 149L396 150Z" },
			            { "PB", 379, 130, "Nordeste", "M399 124L400 135L393 134L392 136L383 138L377 142L376 139L374 139L377 134L375 132L364 137L360 135L362 131L360 127L362 122L366 123L375 118L372 125L380 126L381 129L384 122L399 124Z" },
			            { "CE", 351, 108, "Nordeste", "M362 122L360 127L362 131L357 137L350 132L341 132L343 126L339 122L335 106L337 99L333 89L335 84L348 84L363 93L375 104L376 106L371 108L362 122Z" },
			            { "SE", 371, 167, "Nordeste", "M382 166L369 177L365 175L363 170L364 168L366 168L368 167L368 161L366 155L377 161L382 166Z" },
			            { "RR", 128, 33, "Norte", "M108 31L108 29L101 28L99 17L94 10L101 14L109 14L112 17L114 16L114 13L132 8L136 4L136 1L140 0L143 2L141 8L146 9L147 14L144 20L142 26L145 31L145 35L153 41L154 52L142 52L137 63L131 59L127 61L126 69L117 62L119 61L116 54L117 46L114 38L115 34L108 31Z" },
			            { "PE", 367, 143, "Nordeste", "M396 150L387 149L383 153L377 154L369 148L364 153L361 148L360 149L353 144L340 154L337 147L332 145L341 139L341 136L340 132L341 132L350 132L356 137L360 135L364 137L375 132L377 134L374 139L376 139L377 142L383 138L389 138L393 134L397 134L400 136L400 139L396 150Z" },
			            { "PR", 226, 306, "Sul", "M207 323L205 316L203 315L200 316L198 314L203 312L201 312L201 308L203 307L201 301L209 288L214 285L222 284L235 289L242 289L245 293L247 301L248 307L254 307L255 311L258 311L260 313L256 316L257 313L256 316L253 314L256 317L254 321L245 323L242 321L235 321L229 324L228 327L207 323Z" },
			            { "ES", 333, 259, "Sudeste", "M321 271L321 267L326 265L330 258L331 255L328 251L331 251L330 246L333 244L332 242L337 242L344 247L343 258L329 277L322 274L321 271Z" },
			            { "RJ", 312, 285, "Sudeste", "M292 296L291 292L297 289L291 286L316 280L318 272L321 271L322 274L329 277L328 279L328 284L318 289L317 293L308 293L308 290L306 290L306 293L299 293L302 293L299 292L296 295L296 292L295 292L292 293L294 295L292 296Z" },
			            { "RN", 381, 117, "Nordeste", "M362 122L371 108L376 106L383 109L394 110L399 124L391 123L384 122L381 129L380 126L372 125L375 118L366 123L362 122Z" },
			            { "AM", 94, 98, "Norte", "M108 31L115 34L114 38L117 46L116 54L119 61L117 62L123 68L126 69L127 61L131 59L135 63L139 61L142 52L154 52L154 58L159 65L176 76L178 76L180 79L158 123L162 129L158 144L126 144L124 145L115 137L107 137L102 142L101 147L95 148L92 152L90 151L85 154L78 152L74 157L37 141L2 131L3 128L9 124L7 120L10 109L19 104L30 101L33 98L40 100L46 67L43 60L39 55L39 48L48 47L47 43L41 43L41 36L58 36L58 33L60 36L66 32L69 36L70 42L72 41L79 46L85 44L85 47L90 42L100 38L101 34L108 31Z" },
			            { "MT", 185, 187, "Centro-Oeste", "M162 129L167 138L168 144L176 150L242 155L237 172L239 187L233 206L227 210L225 216L217 221L218 223L212 231L213 238L204 237L207 230L203 234L199 233L192 235L183 230L177 231L173 236L169 237L161 231L161 221L144 221L142 213L139 209L142 209L141 204L140 198L137 195L140 192L146 181L143 173L144 171L143 169L139 167L128 167L127 145L158 144L162 129Z" },
			            { "DF", 266, 216, "Centro-Oeste", "M270 219L262 219L262 213L269 214L270 219Z" },
			            { "AC", 37, 153, "Norte", "M76 158L65 167L62 167L60 170L55 172L49 170L36 171L36 154L30 160L20 161L18 157L9 156L11 151L0 136L3 133L2 131L37 141L76 158Z" },
			            { "RO", 115, 167, "Norte", "M137 195L134 193L126 194L122 189L116 188L113 185L100 183L93 179L89 170L89 155L74 157L78 152L85 154L90 151L92 152L95 148L101 147L102 142L107 137L115 137L121 145L127 145L128 167L139 167L143 169L144 171L143 173L146 181L140 192L137 195Z" } }
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _estados,
			        "@v",
			            VAR _uf = [Sigla]
			            RETURN CALCULATE ( [Receita], KEEPFILTERS ( TREATAS ( { _uf }, dim_cliente[uf] ) ) )
			    )
			VAR _tot = SUMX ( _t, [@v] )
			VAR _max = MAXX ( _t, [@v] )
			VAR _vend = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			-- estados pintados (coropleto)
			VAR _formas =
			    CONCATENATEX (
			        _t,
			        VAR _a = IF ( ISBLANK ( [@v] ), 0, SQRT ( DIVIDE ( [@v], _max ) ) )
			        VAR _fill = "rgb(" & FORMAT ( 17 + 20 * _a, "0" ) & "," & FORMAT ( 26 + 73 * _a, "0" ) & "," & FORMAT ( 58 + 177 * _a, "0" ) & ")"
			        RETURN "<path d='" & [Forma] & "' fill='" & _fill & "' fill-opacity='0.9' stroke='#60a5fa' stroke-opacity='0.45' stroke-width='0.7'/>",
			        ""
			    )
			-- bolhas
			VAR _bolhas =
			    CONCATENATEX (
			        _vend,
			        VAR _r = 4 + 24 * SQRT ( DIVIDE ( [@v], _max ) )
			        VAR _cor = IF ( [@v] >= 1000000, "#a855f7", IF ( [@v] >= 250000, "#22d3ee", "#f472b6" ) )
			        RETURN
			            "<g><title>" & [Sigla] & ": R$ " & FORMAT ( [@v], "#,##0" ) & "</title>"
			                & "<circle cx='" & [X] & "' cy='" & [Y] & "' r='" & FORMAT ( _r * 1.6, "0" ) & "' fill='" & _cor & "' fill-opacity='0.12'/>"
			                & "<circle cx='" & [X] & "' cy='" & [Y] & "' r='" & FORMAT ( _r, "0" ) & "' fill='" & _cor & "' fill-opacity='0.6' stroke='" & _cor & "' stroke-width='1.5'/>"
			                & IF ( _r >= 12, "<text x='" & [X] & "' y='" & ( [Y] + 4 ) & "' text-anchor='middle' font-size='10' font-weight='700' fill='#ffffff'>" & [Sigla] & "</text>", "" )
			            & "</g>",
			        "", [@v], DESC
			    )
			-- etiquetas dos 3 maiores (empilhadas no canto inferior esquerdo, fora do território)
			VAR _top3 = TOPN ( 3, _vend, [@v], DESC )
			VAR _top3r = ADDCOLUMNS ( _top3, "@k", RANKX ( _top3, [@v], , DESC ) )
			VAR _etiquetas =
			    CONCATENATEX (
			        _top3r,
			        VAR _ly = 300 + ( [@k] - 1 ) * 27
			        VAR _val = IF ( [@v] >= 1000000, "R$ " & FORMAT ( [@v] / 1000000, "0.0" ) & " Mi", "R$ " & FORMAT ( [@v] / 1000, "0" ) & " mil" )
			        RETURN
			            "<line x1='" & [X] & "' y1='" & [Y] & "' x2='96' y2='" & ( _ly - 6 ) & "' stroke='#cbd5e1' stroke-opacity='0.45' stroke-width='0.8'/>"
			                & "<rect x='4' y='" & ( _ly - 17 ) & "' width='92' height='22' rx='6' fill='#0b1023' fill-opacity='0.9' stroke='#a78bfa' stroke-opacity='0.6'/>"
			                & "<text x='50' y='" & ( _ly - 2 ) & "' text-anchor='middle' font-size='10' font-weight='700' fill='#ffffff'>" & [Sigla] & " " & _val & "</text>",
			        "", [@k], ASC
			    )
			-- top 5 estados
			VAR _top5 = TOPN ( 5, _vend, [@v], DESC )
			VAR _top5r = ADDCOLUMNS ( _top5, "@k", RANKX ( _top5, [@v], , DESC ) )
			VAR _ranking =
			    CONCATENATEX (
			        _top5r,
			        VAR _val = IF ( [@v] >= 1000000, "R$ " & FORMAT ( [@v] / 1000000, "0.0" ) & " Mi", "R$ " & FORMAT ( [@v] / 1000, "0" ) & " mil" )
			        RETURN
			            "<div class='rk'><span style='color:#94a3b8'>" & [@k] & ". <b style='color:#ffffff'>" & [Sigla] & "</b></span>"
			                & "<span style='color:#ffffff;font-weight:600'>" & _val & "</span>"
			                & "<span style='color:#38bdf8;width:42px;text-align:right'>" & FORMAT ( DIVIDE ( [@v], _tot ), "0.0%" ) & "</span></div>",
			        "", [@k], ASC
			    )
			-- receita por região
			VAR _reg =
			    ADDCOLUMNS (
			        GROUPBY ( _t, [Regiao], "@r", SUMX ( CURRENTGROUP (), [@v] ) ),
			        "@o", SWITCH ( [Regiao], "Sudeste", 1, "Sul", 2, "Nordeste", 3, "Centro-Oeste", 4, 5 ),
			        "@c", SWITCH ( [Regiao], "Sudeste", "#a855f7", "Sul", "#6366f1", "Nordeste", "#22d3ee", "Centro-Oeste", "#38bdf8", "#f472b6" )
			    )
			VAR _regV = FILTER ( _reg, NOT ISBLANK ( [@r] ) )
			VAR _barra =
			    CONCATENATEX (
			        _regV,
			        "<div title='" & [Regiao] & "' style='flex:" & FORMAT ( DIVIDE ( [@r], _tot ) * 1000, "0" ) & ";background:" & [@c] & ";box-shadow:0 0 6px " & [@c] & "'></div>",
			        "", [@o], ASC
			    )
			VAR _legReg =
			    CONCATENATEX (
			        _regV,
			        "<div><span style='background:" & [@c] & "'></span>" & [Regiao] & " <b style='color:#ffffff'>" & FORMAT ( DIVIDE ( [@r], _tot ), "0%" ) & "</b></div>",
			        "", [@o], ASC
			    )
			-- destaques
			VAR _regTop = TOPN ( 1, _regV, [@r], DESC )
			VAR _regNome = CONCATENATEX ( _regTop, [Regiao] )
			VAR _regPct = DIVIDE ( MAXX ( _regTop, [@r] ), _tot )
			VAR _ufTop = TOPN ( 1, _vend, [@v], DESC )
			VAR _ufNome = CONCATENATEX ( _ufTop, [Sigla] )
			VAR _ufPct = DIVIDE ( MAXX ( _ufTop, [@v] ), _tot )
			RETURN
			    "<div class='card' style='grid-area:m'>
			        <div class='ctitle'>Vendas por estado</div>
			        <div style='display:flex;gap:8px;margin-bottom:6px'>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>" & _regNome & "</div><div class='v' style='font-size:15px'>" & FORMAT ( _regPct, "0%" ) & " da receita</div></div>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>Estado líder</div><div class='v' style='font-size:15px'>" & _ufNome & " · " & FORMAT ( _ufPct, "0%" ) & "</div></div>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>Estados c/ vendas</div><div class='v' style='font-size:15px'>" & COUNTROWS ( _vend ) & " de 27</div></div>
			        </div>
			        <div style='position:relative;flex:1;min-height:0;display:flex'>
			            <svg viewBox='0 0 400 399' preserveAspectRatio='xMidYMin meet' style='flex:1;min-height:0;width:100%'>"
			                & _formas & _bolhas & _etiquetas &
			            "</svg>
			            <div class='rank'><div class='lbl' style='font-size:10px;margin-bottom:4px'>Top 5 estados</div>" & _ranking & "</div>
			        </div>
			        <div style='display:flex;height:10px;border-radius:5px;overflow:hidden;margin-top:8px;gap:2px'>" & _barra & "</div>
			        <div class='leg' style='flex-wrap:wrap;gap:10px;font-size:11px'>" & _legReg & "</div>
			        <div class='leg' style='margin-top:2px;font-size:10px'>
			            <div><span style='background:#a855f7'></span>&gt; R$ 1 Mi</div>
			            <div><span style='background:#22d3ee'></span>R$ 250 mil – 1 Mi</div>
			            <div><span style='background:#f472b6'></span>&lt; R$ 250 mil</div>
			        </div>
			    </div>"
		lineageTag: 6f1ec812-a4db-419f-b874-c369837acd30

	measure 'HTML Minis' =
			
			"<div class='minis'>
			    <div class='card mini'><div class='lbl'>Frete / receita</div><div class='mv'>" & FORMAT ( [% Frete Receita], "0.0%" ) & "</div>
			        <div class='sub2'>" & FORMAT ( [Frete por Pedido], "R$ #,##0.00" ) & " por pedido</div></div>
			    <div class='card mini'><div class='lbl'>Clientes únicos</div><div class='mv'>" & FORMAT ( [Clientes Únicos], "#,##0" ) & "</div>
			        <div class='sub2'>" & FORMAT ( [Pedidos por Cliente], "0.00" ) & " pedido por cliente</div></div>
			    <div class='card mini'><div class='lbl'>Taxa de recompra</div><div class='mv'>" & FORMAT ( [Taxa de Recompra], "0.0%" ) & "</div>
			        <div class='sub2'>clientes com 2+ pedidos</div></div>
			</div>"
		lineageTag: 2acd20fb-9600-4312-a9e2-f1680d97eb2c

	measure 'HTML Top Categorias' = ```
			
			VAR _t =
			    TOPN (
			        5,
			        FILTER ( ADDCOLUMNS ( VALUES ( dim_produto[categoria] ), "@v", [Receita] ), NOT ISBLANK ( [@v] ) ),
			        [@v], DESC
			    )
			VAR _max = MAXX ( _t, [@v] )
			VAR _rows =
			    CONCATENATEX (
			        _t,
			        "<div class='bar-row'>
			            <div class='bar-name' style='text-transform:capitalize'>" & SUBSTITUTE ( dim_produto[categoria], "_", " " ) & "</div>
			            <div class='bar-bg'><div class='bar' style='width:" & FORMAT ( DIVIDE ( [@v], _max ) * 100, "0" ) & "%'></div></div>
			            <div class='bar-v'>R$ " & FORMAT ( [@v] / 1000, "#,##0" ) & " mil</div>
			        </div>",
			        "", [@v], DESC
			    )
			RETURN
