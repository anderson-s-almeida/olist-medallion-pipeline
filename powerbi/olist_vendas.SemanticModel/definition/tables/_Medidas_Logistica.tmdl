			            { "CE", 351, 108, 9, "M362 122L360 127L362 131L357 137L350 132L341 132L343 126L339 122L335 106L337 99L333 89L335 84L348 84L363 93L375 104L376 106L371 108L362 122Z" },
			            { "SE", 371, 167, 7, "M382 166L369 177L365 175L363 170L364 168L366 168L368 167L368 161L366 155L377 161L382 166Z" },
			            { "RR", 128, 33, 9, "M108 31L108 29L101 28L99 17L94 10L101 14L109 14L112 17L114 16L114 13L132 8L136 4L136 1L140 0L143 2L141 8L146 9L147 14L144 20L142 26L145 31L145 35L153 41L154 52L142 52L137 63L131 59L127 61L126 69L117 62L119 61L116 54L117 46L114 38L115 34L108 31Z" },
			            { "PE", 367, 143, 7, "M396 150L387 149L383 153L377 154L369 148L364 153L361 148L360 149L353 144L340 154L337 147L332 145L341 139L341 136L340 132L341 132L350 132L356 137L360 135L364 137L375 132L377 134L374 139L376 139L377 142L383 138L389 138L393 134L397 134L400 136L400 139L396 150Z" },
			            { "PR", 226, 306, 9, "M207 323L205 316L203 315L200 316L198 314L203 312L201 312L201 308L203 307L201 301L209 288L214 285L222 284L235 289L242 289L245 293L247 301L248 307L254 307L255 311L258 311L260 313L256 316L257 313L256 316L253 314L256 317L254 321L245 323L242 321L235 321L229 324L228 327L207 323Z" },
			            { "ES", 333, 259, 7, "M321 271L321 267L326 265L330 258L331 255L328 251L331 251L330 246L333 244L332 242L337 242L344 247L343 258L329 277L322 274L321 271Z" },
			            { "RJ", 312, 285, 7, "M292 296L291 292L297 289L291 286L316 280L318 272L321 271L322 274L329 277L328 279L328 284L318 289L317 293L308 293L308 290L306 290L306 293L299 293L302 293L299 292L296 295L296 292L295 292L292 293L294 295L292 296Z" },
			            { "RN", 381, 117, 7, "M362 122L371 108L376 106L383 109L394 110L399 124L391 123L384 122L381 129L380 126L372 125L375 118L366 123L362 122Z" },
			            { "AM", 94, 98, 9, "M108 31L115 34L114 38L117 46L116 54L119 61L117 62L123 68L126 69L127 61L131 59L135 63L139 61L142 52L154 52L154 58L159 65L176 76L178 76L180 79L158 123L162 129L158 144L126 144L124 145L115 137L107 137L102 142L101 147L95 148L92 152L90 151L85 154L78 152L74 157L37 141L2 131L3 128L9 124L7 120L10 109L19 104L30 101L33 98L40 100L46 67L43 60L39 55L39 48L48 47L47 43L41 43L41 36L58 36L58 33L60 36L66 32L69 36L70 42L72 41L79 46L85 44L85 47L90 42L100 38L101 34L108 31Z" },
			            { "MT", 185, 187, 9, "M162 129L167 138L168 144L176 150L242 155L237 172L239 187L233 206L227 210L225 216L217 221L218 223L212 231L213 238L204 237L207 230L203 234L199 233L192 235L183 230L177 231L173 236L169 237L161 231L161 221L144 221L142 213L139 209L142 209L141 204L140 198L137 195L140 192L146 181L143 173L144 171L143 169L139 167L128 167L127 145L158 144L162 129Z" },
			            { "DF", 266, 216, 7, "M270 219L262 219L262 213L269 214L270 219Z" },
			            { "AC", 37, 153, 9, "M76 158L65 167L62 167L60 170L55 172L49 170L36 171L36 154L30 160L20 161L18 157L9 156L11 151L0 136L3 133L2 131L37 141L76 158Z" },
			            { "RO", 115, 167, 9, "M137 195L134 193L126 194L122 189L116 188L113 185L100 183L93 179L89 170L89 155L74 157L78 152L85 154L90 151L92 152L95 148L101 147L102 142L107 137L115 137L121 145L127 145L128 167L139 167L143 169L144 171L143 173L146 181L140 192L137 195Z" } }
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _estados,
			        "@d",
			            VAR _uf = [Sigla]
			            RETURN CALCULATE ( [Dias Médios Entrega], KEEPFILTERS ( TREATAS ( { _uf }, dim_cliente[uf] ) ) )
			    )
			VAR _com = FILTER ( _t, NOT ISBLANK ( [@d] ) )
			VAR _min = MINX ( _com, [@d] )
			VAR _max = MAXX ( _com, [@d] )
			VAR _formas =
			    CONCATENATEX (
			        _t,
			        VAR _k = IF ( ISBLANK ( [@d] ), BLANK (), DIVIDE ( [@d] - _min, _max - _min ) )
			        -- verde (52,211,153) -> amarelo (251,191,36) até 0,45 -> vermelho (248,113,113)
			        VAR _r = IF ( ISBLANK ( _k ), 30, IF ( _k <= 0.45, 52 + ( 251 - 52 ) * _k / 0.45, 251 + ( 248 - 251 ) * ( _k - 0.45 ) / 0.55 ) )
			        VAR _g = IF ( ISBLANK ( _k ), 41, IF ( _k <= 0.45, 211 + ( 191 - 211 ) * _k / 0.45, 191 + ( 113 - 191 ) * ( _k - 0.45 ) / 0.55 ) )
			        VAR _b = IF ( ISBLANK ( _k ), 59, IF ( _k <= 0.45, 153 + ( 36 - 153 ) * _k / 0.45, 36 + ( 113 - 36 ) * ( _k - 0.45 ) / 0.55 ) )
			        RETURN
			            "<path d='" & [Forma] & "' fill='rgb(" & FORMAT ( _r, "0" ) & "," & FORMAT ( _g, "0" ) & "," & FORMAT ( _b, "0" ) & ")' fill-opacity='0.75' stroke='#0b1023' stroke-width='0.9'>"
			                & "<title>" & [Sigla] & ": " & IF ( ISBLANK ( [@d] ), "sem entregas", FORMAT ( [@d], "0.0" ) & " dias" ) & "</title></path>",
			        ""
			    )
			VAR _siglas =
			    CONCATENATEX (
			        _t,
			        "<text x='" & [X] & "' y='" & ( [Y] + 3 ) & "' text-anchor='middle' font-size='" & [Fonte] & "' font-weight='700' fill='#0b1023' pointer-events='none'>" & [Sigla] & "</text>",
			        ""
			    )
			VAR _rapido = TOPN ( 1, _com, [@d], ASC )
			VAR _lento = TOPN ( 1, _com, [@d], DESC )
			VAR _top5 = TOPN ( 5, _com, [@d], DESC )
			VAR _ranking =
			    CONCATENATEX (
			        _top5,
			        "<div class='rk'><b style='color:#ffffff'>" & [Sigla] & "</b><span style='color:#fca5a5;font-weight:700'>" & FORMAT ( [@d], "0.0" ) & " dias</span></div>",
			        "", [@d], DESC
			    )
			RETURN
			    "<div class='card' style='grid-area:m'>
			        <div class='ctitle'>Prazo médio de entrega por estado</div>
			        <div style='display:flex;gap:8px;margin-bottom:6px'>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>Mais rápido</div><div class='v' style='font-size:15px;color:#34d399'>" & CONCATENATEX ( _rapido, [Sigla] ) & " · " & FORMAT ( _min, "0.0" ) & " dias</div></div>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>Mais lento</div><div class='v' style='font-size:15px;color:#f87171'>" & CONCATENATEX ( _lento, [Sigla] ) & " · " & FORMAT ( _max, "0.0" ) & " dias</div></div>
			            <div class='pill' style='flex:1;padding:6px 8px'><div class='lbl' style='font-size:10px'>Diferença</div><div class='v' style='font-size:15px'>" & FORMAT ( DIVIDE ( _max, _min ), "0.0" ) & "×</div></div>
			        </div>
			        <div style='position:relative;flex:1;min-height:0;display:flex'>
			            <svg viewBox='0 0 400 399' preserveAspectRatio='xMidYMin meet' style='flex:1;min-height:0;width:100%'>" & _formas & _siglas & "</svg>
			            <div class='rank'><div class='lbl' style='font-size:10px;margin-bottom:4px'>5 mais lentos</div>" & _ranking & "</div>
			        </div>
			        <div style='display:flex;align-items:center;gap:8px;font-size:11px;color:#94a3b8;margin-top:6px'>
			            <span>rápido</span><div style='flex:1;height:8px;border-radius:4px;background:linear-gradient(90deg,#34d399,#fbbf24,#f87171)'></div><span>lento</span>
			        </div>
			    </div>"
		lineageTag: 3c07cb5d-ce58-4643-8098-8893987f2bf6

	measure 'HTML Tempo Entrega' = ```
			
			VAR _faixas =
			    DATATABLE (
			        "Faixa", STRING, "Min", INTEGER, "Max", INTEGER, "Cor", STRING, "Ord", INTEGER,
			        {
			            { "até 7 dias", 0, 7, "#34d399", 1 },
			            { "8 a 15 dias", 8, 15, "#22d3ee", 2 },
			            { "16 a 30 dias", 16, 30, "#fbbf24", 3 },
			            { "mais de 30", 31, 9999, "#f87171", 4 }
			        }
			    )
			VAR _tot = [Pedidos Entregues]
			VAR _t =
			    ADDCOLUMNS (
			        _faixas,
			        "@p",
			            VAR _mn = [Min]
			            VAR _mx = [Max]
			            RETURN DIVIDE ( CALCULATE ( [Pedidos], KEEPFILTERS ( fato_vendas[dias_entrega] >= _mn && fato_vendas[dias_entrega] <= _mx ) ), _tot )
			    )
			VAR _pmax = MAXX ( _t, [@p] )
			VAR _linhas =
			    CONCATENATEX (
			        _t,
			        "<div class='nrow'>
			            <div style='width:84px'>" & [Faixa] & "</div>
			            <div class='bar-bg' style='flex:1;height:14px'><div class='bar' style='height:14px;width:" & FORMAT ( DIVIDE ( [@p], _pmax ) * 100, "0" ) & "%;background:" & [Cor] & ";box-shadow:0 0 8px " & [Cor] & "'></div></div>
			            <div style='width:44px;text-align:right;color:#ffffff;font-weight:700'>" & FORMAT ( [@p], "0%" ) & "</div>
			        </div>",
			        "", [Ord], ASC
			    )
			RETURN
			    "<div class='card' style='grid-area:d'>
			        <div class='ctitle'>Tempo até a entrega</div>
			        <div style='flex:1;display:flex;flex-direction:column;justify-content:space-around'>" & _linhas & "</div>
			        <div class='sub'>% dos pedidos entregues</div>
			    </div>"
			
			```
		lineageTag: bdc989f6-ab6c-4351-bff2-c377057f28bf

	measure 'HTML Rotas Lentas' = ```
			
			VAR _rotas =
			    FILTER (
			        ADDCOLUMNS (
			            SUMMARIZE ( fato_vendas, dim_vendedor[uf], dim_cliente[uf] ),
			            "@p", [Pedidos Entregues],
			            "@d", [Dias Médios Entrega],
			            "@a", [% Entregas com Atraso]
			        ),
			        [@p] >= 20 && NOT ISBLANK ( [@d] )
			    )
			VAR _top = TOPN ( 12, _rotas, [@d], DESC )
			VAR _dmax = MAXX ( _top, [@d] )
			VAR _linhas =
			    CONCATENATEX (
			        _top,
			        "<tr>
			            <td><b>" & dim_vendedor[uf] & "</b> <span style='color:#64748b'>→</span> <b>" & dim_cliente[uf] & "</b></td>
			            <td>" & FORMAT ( [@p], "#,##0" ) & "</td>
			            <td><span class='mb' style='width:" & FORMAT ( DIVIDE ( [@d], _dmax ) * 60, "0" ) & "px;background:linear-gradient(90deg,#fbbf24,#f87171)'></span>" & FORMAT ( [@d], "0.0" ) & " dias</td>
			            <td><span class='chip " & IF ( [@a] >= 0.15, "cr", IF ( [@a] >= 0.09, "cy", "cg" ) ) & "'>" & FORMAT ( [@a], "0%" ) & "</span></td>
			        </tr>",
			        "", [@d], DESC
			    )
			RETURN
			    "<div class='card' style='grid-area:r'>
			        <div style='display:flex;justify-content:space-between;align-items:baseline'>
			            <div class='ctitle'>Rotas mais lentas</div>
			            <div class='sub'>UF do vendedor → UF do cliente · mín. 20 pedidos</div>
			        </div>
			        <div style='flex:1;overflow:hidden'>
			            <table class='tbl'>
			                <tr><th>Rota</th><th>Pedidos</th><th>Prazo médio</th><th>% Atraso</th></tr>" & _linhas & "
			            </table>
			        </div>
			    </div>"
			
			```
		lineageTag: 7747511b-9169-4ed5-b56f-60d488a8cc44

	measure 'HTML Minis Logistica' =
			
			VAR _mesmo = [Prazo Mesmo Estado]
			VAR _inter = [Prazo Interestadual]
			RETURN
			    "<div class='kgrid'>
			        <div class='card mini'><div class='lbl'>🏠 Mesmo estado</div>
			            <div class='mv' style='font-size:22px;color:#34d399'>" & FORMAT ( _mesmo, "0.0" ) & " dias</div>
			            <div class='sub2'>vendedor e cliente na mesma UF</div></div>
			        <div class='card mini'><div class='lbl'>🚚 Interestadual</div>
			            <div class='mv' style='font-size:22px;color:#fbbf24'>" & FORMAT ( _inter, "0.0" ) & " dias</div>
			            <div class='sub2'>" & FORMAT ( DIVIDE ( _inter, _mesmo ), "0.0" ) & "× o prazo do mesmo estado</div></div>
			        <div class='card mini'><div class='lbl'>⚡ Até 7 dias</div>
			            <div class='mv' style='font-size:22px;color:#c4b5fd'>" & FORMAT ( [% Entregue ate 7 Dias], "0%" ) & "</div>
			            <div class='sub2'>dos pedidos entregues</div></div>
			    </div>"
		lineageTag: c809d6d5-3ef6-45bb-93f7-92b80f616685

	measure 'HTML Logistica' =
			
			[HTML Estilo Logistica]
			    & "<div class='dash'>"
			    & [HTML Cab Logistica]
			    & [HTML Atraso Nota]
			    & [HTML Atraso Mensal]
			    & [HTML Mapa Prazo]
			    & [HTML Tempo Entrega]
			    & [HTML Rotas Lentas]
			    & [HTML Minis Logistica]
			    & "</div>"
		lineageTag: 669685b0-b9e2-4b43-ae4b-86f8ee354560

	partition _Medidas_Logistica = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

