table _Medidas_Logistica
	lineageTag: 30414d3a-11a7-4b0d-b8fd-55c15f5441b2

	measure 'Pedidos Entregues' = CALCULATE ( [Pedidos], NOT ISBLANK ( fato_vendas[dias_entrega] ) )
		formatString: 0
		lineageTag: 6af9c728-b297-4866-9d2e-767bdf62c570

	measure 'Pedidos Atrasados' = CALCULATE ( [Pedidos], fato_vendas[entregue_com_atraso] = TRUE () )
		formatString: 0
		lineageTag: 2b8d4fe0-3326-464a-9f7f-0329af1775cd

	measure 'Prazo dos Atrasados' = CALCULATE ( [Dias Médios Entrega], fato_vendas[entregue_com_atraso] = TRUE () )
		lineageTag: 95277a83-1ff4-4479-b254-63e621dd50e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Entregue ate 7 Dias' = DIVIDE ( CALCULATE ( [Pedidos], fato_vendas[dias_entrega] <= 7 ), [Pedidos Entregues] )
		lineageTag: e3019932-5ba3-46d7-bc31-1e8e649bdf5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prazo Mesmo Estado' =
			
			AVERAGEX (
			    FILTER ( fato_vendas, RELATED ( dim_cliente[uf] ) = RELATED ( dim_vendedor[uf] ) ),
			    fato_vendas[dias_entrega]
			)
		lineageTag: eb8a0656-1370-4ea6-b2f8-47ed8ed73437

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prazo Interestadual' =
			
			AVERAGEX (
			    FILTER ( fato_vendas, RELATED ( dim_cliente[uf] ) <> RELATED ( dim_vendedor[uf] ) ),
			    fato_vendas[dias_entrega]
			)
		lineageTag: b980f00b-b807-45dd-b685-b01ea454bb57

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'HTML Estilo Logistica' =
			
			"<style>
			.dash{font-family:'Segoe UI',sans-serif;color:#e2e8f0;padding:16px 18px;box-sizing:border-box;height:100vh;
			 background:radial-gradient(circle at 15% 0%,#1e1b4b 0%,transparent 45%),radial-gradient(circle at 95% 100%,#0c3a5e 0%,transparent 45%),#070b1a;
			 display:grid;gap:16px;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:78px 46px 1fr 1fr 1fr;
			 grid-template-areas:'h h h h h h h h h h h h' 'f f f f f f f f f f f f' 'a a a a e e e e m m m m' 'd d d d r r r r m m m m' 'k k k k r r r r m m m m';}
			.card{background:linear-gradient(160deg,rgba(30,41,82,.85),rgba(12,17,40,.92));border:1px solid rgba(96,165,250,.25);border-radius:16px;
			 box-shadow:0 0 18px rgba(59,130,246,.18),inset 0 0 14px rgba(139,92,246,.08);padding:14px 18px;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;min-height:0;}
			.header{grid-area:h;flex-direction:row !important;justify-content:space-between;align-items:center;gap:12px;padding:8px 18px !important;}
			.title{font-size:20px;font-weight:700;color:#ffffff;}
			.sub{font-size:12px;color:#94a3b8;margin-top:2px;}
			.pills{display:flex;gap:10px;flex-wrap:wrap;}
			.pill{background:rgba(15,23,42,.85);border:1px solid rgba(139,92,246,.35);border-radius:12px;padding:4px 16px;text-align:center;box-shadow:0 0 10px rgba(139,92,246,.15);}
			.pill .lbl{font-size:10px;}
			.pill .v{font-size:17px;font-weight:700;color:#ffffff;}
			.lbl{font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;}
			.ctitle{font-size:15px;font-weight:600;color:#ffffff;margin-bottom:8px;}
			.dest{display:flex;gap:22px;align-items:center;flex:1;}
			.icon{font-size:70px;width:130px;height:130px;border-radius:22px;display:flex;align-items:center;justify-content:center;
			 background:rgba(15,23,42,.85);border:1px solid rgba(96,165,250,.35);box-shadow:0 0 22px rgba(59,130,246,.35);}
			.kpi{display:flex;align-items:center;gap:10px;margin:7px 0;}
			.kdot{width:26px;height:26px;border-radius:50%;background:rgba(59,130,246,.18);border:1px solid rgba(96,165,250,.35);display:flex;align-items:center;justify-content:center;font-size:13px;}
			.kv{font-size:19px;font-weight:700;color:#38bdf8;}
			.bar-row{display:flex;align-items:center;gap:10px;margin:0;font-size:13px;color:#cbd5e1;}
			.bar-name{width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
			.bar-bg{flex:1;height:12px;background:#1e293b;border-radius:5px;}
			.bar{height:12px;border-radius:6px;background:linear-gradient(90deg,#3b82f6,#a855f7);box-shadow:0 0 8px rgba(139,92,246,.6);}
			.bar-v{width:90px;text-align:right;font-weight:600;color:#ffffff;}
			.minis{grid-area:s;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
			.mini{text-align:center;padding:12px 6px;display:flex;flex-direction:column;justify-content:center;}
			.mini .mv{font-size:28px;font-weight:700;color:#38bdf8;margin-top:4px;}
			.mini .mi{font-size:20px;margin-top:2px;}
			.leg{display:flex;justify-content:center;gap:16px;font-size:12px;color:#94a3b8;margin-top:6px;}
			.leg span{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:4px;vertical-align:middle;}
			.kp{display:flex;align-items:center;gap:10px;text-align:left;padding:6px 14px !important;}
			.kp .v{font-size:18px;}
			.up{color:#34d399;font-size:11px;font-weight:600;}
			.dn{color:#f87171;font-size:11px;font-weight:600;}
			.split{display:flex;gap:10px;flex:1;min-height:0;}
			.split>div{flex:1;display:flex;flex-direction:column;min-height:0;}
			.nrow{display:flex;align-items:center;gap:8px;font-size:12px;color:#cbd5e1;}
			.nrow .bar-bg{height:10px;}
			.nrow .bar{height:10px;}
			.mini .sub2{font-size:11px;color:#94a3b8;margin-top:2px;}
			.rank{position:absolute;right:0;bottom:4px;width:160px;background:rgba(11,16,35,.88);border:1px solid rgba(139,92,246,.35);border-radius:10px;padding:8px 10px;box-shadow:0 0 12px rgba(139,92,246,.2);}
			.rk{display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:3px 0;border-bottom:1px solid rgba(96,165,250,.12);}
			.tbl{width:100%;border-collapse:collapse;font-size:12px;}
			.tbl th{font-size:10px;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;text-align:right;padding:6px;border-bottom:1px solid rgba(96,165,250,.25);font-weight:600;}
			.tbl th:first-child,.tbl td:first-child{text-align:left;}
			.tbl td{padding:6px;border-bottom:1px solid rgba(96,165,250,.10);text-align:right;color:#e2e8f0;white-space:nowrap;}
			.tbl tr:hover td{background:rgba(59,130,246,.08);}
			.mb{display:inline-block;height:8px;border-radius:4px;background:linear-gradient(90deg,#3b82f6,#a855f7);vertical-align:middle;margin-right:6px;box-shadow:0 0 6px rgba(139,92,246,.5);}
			.chip{display:inline-block;padding:1px 7px;border-radius:8px;font-size:11px;font-weight:600;}
			.cg{background:rgba(52,211,153,.15);color:#34d399;}
			.cr{background:rgba(248,113,113,.15);color:#f87171;}
			.cy{background:rgba(251,191,36,.15);color:#fbbf24;}
			.kgrid{grid-area:k;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
			.kgrid .mini{padding:10px 8px;}
			.big{font-size:40px;font-weight:800;line-height:1.1;}
			.rank{position:absolute;right:0;bottom:4px;width:150px;background:rgba(11,16,35,.88);border:1px solid rgba(139,92,246,.35);border-radius:10px;padding:8px 10px;box-shadow:0 0 12px rgba(139,92,246,.2);}
			.rk{display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:3px 0;border-bottom:1px solid rgba(96,165,250,.12);}
			</style>"
		lineageTag: 75b81613-9ee0-4904-9bee-e2bde4c68433

	measure 'HTML Cab Logistica' =
			
			VAR _o = [Ref Ano Mes]
			VAR _ano = INT ( _o / 10000 )
			VAR _mes = INT ( MOD ( _o, 10000 ) / 100 )
			VAR _filtroMes = ISFILTERED ( dim_data[mes] ) || ISFILTERED ( dim_data[ano_mes] )
			VAR _przA = CALCULATE ( [Dias Médios Entrega], dim_data[ano] = _ano, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _przB = CALCULATE ( [Dias Médios Entrega], dim_data[ano] = _ano - 1, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _okA = CALCULATE ( [% Entregas no Prazo], dim_data[ano] = _ano, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _okB = CALCULATE ( [% Entregas no Prazo], dim_data[ano] = _ano - 1, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _patA = CALCULATE ( [Prazo dos Atrasados], dim_data[ano] = _ano, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _patB = CALCULATE ( [Prazo dos Atrasados], dim_data[ano] = _ano - 1, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _atrA = CALCULATE ( [Pedidos Atrasados], dim_data[ano] = _ano, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _atrB = CALCULATE ( [Pedidos Atrasados], dim_data[ano] = _ano - 1, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _freA = CALCULATE ( [Frete por Pedido], dim_data[ano] = _ano, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _freB = CALCULATE ( [Frete por Pedido], dim_data[ano] = _ano - 1, KEEPFILTERS ( dim_data[mes] <= _mes ) )
			VAR _mesTxt = FORMAT ( DATE ( _ano, _mes, 1 ), "mmm" )
			VAR _periodo = IF ( _filtroMes, _ano & " · meses selec.", _ano & " até " & _mesTxt )
			VAR _base = IF ( _filtroMes, "vs " & ( _ano - 1 ), "vs jan–" & _mesTxt & "/" & ( _ano - 1 ) )
			VAR _semBase = "<div class='lbl'>sem base de comparação</div>"
			-- prazo: diferença em dias (cair é bom)
			VAR _dPrz = _przA - _przB
			VAR _txPrz = IF ( ISBLANK ( _przB ), _semBase, IF ( _dPrz <= 0, "<div class='up'>▼ ", "<div class='dn'>▲ " ) & FORMAT ( ABS ( _dPrz ), "0.0" ) & " dia " & _base & "</div>" )
			-- % no prazo: diferença em pontos percentuais (subir é bom)
			VAR _dOk = ( _okA - _okB ) * 100
			VAR _txOk = IF ( ISBLANK ( _okB ), _semBase, IF ( _dOk >= 0, "<div class='up'>▲ ", "<div class='dn'>▼ " ) & FORMAT ( ABS ( _dOk ), "0.0" ) & " p.p. " & _base & "</div>" )
			-- prazo dos atrasados (cair é bom)
			VAR _dPat = _patA - _patB
			VAR _txPat = IF ( ISBLANK ( _patB ), _semBase, IF ( _dPat <= 0, "<div class='up'>▼ ", "<div class='dn'>▲ " ) & FORMAT ( ABS ( _dPat ), "0.0" ) & " dia " & _base & "</div>" )
			-- pedidos atrasados e frete (subir é ruim)
			VAR _vAtr = DIVIDE ( _atrA - _atrB, _atrB )
			VAR _txAtr = IF ( ISBLANK ( _vAtr ), _semBase, IF ( _vAtr <= 0, "<div class='up'>▼ ", "<div class='dn'>▲ " ) & FORMAT ( ABS ( _vAtr ), "0%" ) & " " & _base & "</div>" )
			VAR _vFre = DIVIDE ( _freA - _freB, _freB )
			VAR _txFre = IF ( ISBLANK ( _vFre ), _semBase, IF ( _vFre <= 0, "<div class='up'>▼ ", "<div class='dn'>▲ " ) & FORMAT ( ABS ( _vFre ), "0.0%" ) & " " & _base & "</div>" )
			VAR _ini = CALCULATE ( MIN ( dim_data[data] ), fato_vendas )
			VAR _fim = CALCULATE ( MAX ( dim_data[data] ), fato_vendas )
			RETURN
			    "<div class='card header'>
			        <div>
			            <div class='title'>Olist | Logística & Entregas</div>
			            <div class='sub'>E-commerce brasileiro · " & FORMAT ( _ini, "mm/yyyy" ) & " a " & FORMAT ( _fim, "mm/yyyy" ) & "</div>
			            <div class='sub' style='color:#a78bfa'>Indicadores: " & _periodo & "</div>
			        </div>
			        <div class='pills'>
			            <div class='pill kp'><div><div class='lbl'>Prazo médio</div><div class='v'>" & FORMAT ( _przA, "0.0" ) & " dias</div>" & _txPrz & "</div></div>
			            <div class='pill kp'><div><div class='lbl'>Entregas no prazo</div><div class='v'>" & FORMAT ( _okA, "0.0%" ) & "</div>" & _txOk & "</div></div>
			            <div class='pill kp'><div><div class='lbl'>Prazo dos atrasados</div><div class='v'>" & FORMAT ( _patA, "0.0" ) & " dias</div>" & _txPat & "</div></div>
			            <div class='pill kp'><div><div class='lbl'>Pedidos atrasados</div><div class='v'>" & FORMAT ( _atrA, "#,##0" ) & "</div>" & _txAtr & "</div></div>
			            <div class='pill kp'><div><div class='lbl'>Frete médio pedido</div><div class='v'>" & FORMAT ( _freA, "R$ #,##0.00" ) & "</div>" & _txFre & "</div></div>
			        </div>
			    </div>"
		lineageTag: 328f7796-589f-4909-b250-707393ef134d

	measure 'HTML Atraso Nota' = ```
			
			VAR _nOk = CALCULATE ( [Nota Média], fato_vendas[entregue_com_atraso] = FALSE () )
			VAR _nAt = CALCULATE ( [Nota Média], fato_vendas[entregue_com_atraso] = TRUE () )
			VAR _1Ok = DIVIDE (
			    CALCULATE ( [Pedidos], fato_vendas[entregue_com_atraso] = FALSE (), fato_vendas[nota_avaliacao] = 1 ),
			    CALCULATE ( [Pedidos], fato_vendas[entregue_com_atraso] = FALSE (), NOT ISBLANK ( fato_vendas[nota_avaliacao] ) )
			)
			VAR _1At = DIVIDE (
			    CALCULATE ( [Pedidos], fato_vendas[entregue_com_atraso] = TRUE (), fato_vendas[nota_avaliacao] = 1 ),
			    CALCULATE ( [Pedidos], fato_vendas[entregue_com_atraso] = TRUE (), NOT ISBLANK ( fato_vendas[nota_avaliacao] ) )
			)
			VAR _dif = _nAt - _nOk
			RETURN
			    "<div class='card' style='grid-area:a'>
			        <div class='ctitle'>Atraso × Nota</div>
			        <div style='flex:1;display:flex;align-items:center;justify-content:space-around;gap:10px'>
			            <div style='text-align:center'>
			                <div class='lbl'>No prazo</div>
			                <div class='big' style='color:#34d399;text-shadow:0 0 18px rgba(52,211,153,.5)'>" & FORMAT ( _nOk, "0.00" ) & "</div>
			                <div class='sub'>⭐ nota média</div>
			                <div class='sub' style='margin-top:6px'>1 estrela: <b style='color:#ffffff'>" & FORMAT ( _1Ok, "0%" ) & "</b></div>
			            </div>
			            <div style='text-align:center;color:#f87171'>
			                <div style='font-size:22px;font-weight:800'>" & FORMAT ( _dif, "+0.00;-0.00" ) & "</div>
			                <div class='sub'>ponto</div>
			                <div style='font-size:28px'>→</div>
			            </div>
			            <div style='text-align:center'>
			                <div class='lbl'>Atrasado</div>
			                <div class='big' style='color:#f87171;text-shadow:0 0 18px rgba(248,113,113,.5)'>" & FORMAT ( _nAt, "0.00" ) & "</div>
			                <div class='sub'>⭐ nota média</div>
			                <div class='sub' style='margin-top:6px'>1 estrela: <b style='color:#ffffff'>" & FORMAT ( _1At, "0%" ) & "</b></div>
			            </div>
			        </div>
			    </div>"
			
			```
		lineageTag: 2e95d975-24a5-446d-a8dc-2dbac3e70730

	measure 'HTML Atraso Mensal' = ```
			
			VAR _meta = 0.08
			VAR _W = 600
			VAR _H = 200
			VAR _px = 30
			VAR _py = 16
			VAR _baseY = _H - 24
			VAR _b =
			    ADDCOLUMNS (
			        VALUES ( dim_data[ano_mes] ),
			        "@ord", CALCULATE ( MIN ( dim_data[sk_data] ) ),
			        "@ped", [Pedidos],
			        "@a", [% Entregas com Atraso]
			    )
			VAR _mx = MAXX ( _b, [@ped] )
			VAR _t = FILTER ( _b, [@ped] >= _mx * 0.1 && NOT ISBLANK ( [@a] ) )
			VAR _n = COUNTROWS ( _t )
			VAR _media = AVERAGEX ( _t, [@a] )
			VAR _topo = MAX ( MAXX ( _t, [@a] ), _meta ) * 1.15
			VAR _i = ADDCOLUMNS ( _t, "@i", RANKX ( _t, [@ord], , ASC, DENSE ) )
			VAR _xy =
			    ADDCOLUMNS (
			        _i,
			        "@x", _px + DIVIDE ( ( [@i] - 1 ) * ( _W - 2 * _px ), MAX ( _n - 1, 1 ) ),
			        "@y", _baseY - DIVIDE ( [@a], _topo ) * ( _baseY - _py ),
			        "@pico", [@a] >= _media * 1.6
			    )
			VAR _line = CONCATENATEX ( _xy, FORMAT ( [@x], "0" ) & "," & FORMAT ( [@y], "0" ), " ", [@i], ASC )
			VAR _area = _px & "," & _baseY & " " & _line & " " & ( _W - _px ) & "," & _baseY
			VAR _yMeta = FORMAT ( _baseY - DIVIDE ( _meta, _topo ) * ( _baseY - _py ), "0" )
			VAR _grid =
			    CONCATENATEX (
			        GENERATESERIES ( 0, 3, 1 ),
			        VAR _gv = _topo * [Value] / 3
			        VAR _gy = FORMAT ( _baseY - [Value] * ( _baseY - _py ) / 3, "0" )
			        RETURN
			            "<line x1='" & _px & "' x2='" & ( _W - _px ) & "' y1='" & _gy & "' y2='" & _gy & "' stroke='#1e293b'/>"
			                & "<text x='" & ( _px - 4 ) & "' y='" & _gy & "' text-anchor='end' dominant-baseline='middle' font-size='9' fill='#64748b'>" & FORMAT ( _gv, "0%" ) & "</text>",
			        ""
			    )
			VAR _step = IF ( _n > 12, 2, 1 )
			VAR _labels =
			    CONCATENATEX (
			        FILTER ( _xy, MOD ( [@i] - 1, _step ) = 0 ),
			        "<text x='" & FORMAT ( [@x], "0" ) & "' y='" & ( _H - 6 ) & "' text-anchor='middle' font-size='9.5' fill='#94a3b8'>" & RIGHT ( dim_data[ano_mes], 2 ) & "/" & MID ( dim_data[ano_mes], 3, 2 ) & "</text>",
			        "", [@i], ASC
			    )
			VAR _dots =
			    CONCATENATEX (
			        _xy,
			        VAR _m = VALUE ( RIGHT ( dim_data[ano_mes], 2 ) )
			        VAR _nome = IF ( _m = 11, "Black Friday", IF ( _m = 2 || _m = 3, "Carnaval", "pico" ) )
			        RETURN
			            "<g><title>" & RIGHT ( dim_data[ano_mes], 2 ) & "/" & LEFT ( dim_data[ano_mes], 4 ) & ": " & FORMAT ( [@a], "0.0%" ) & " atrasados (" & FORMAT ( [@ped], "#,##0" ) & " pedidos)</title>"
			                & "<circle cx='" & FORMAT ( [@x], "0" ) & "' cy='" & FORMAT ( [@y], "0" ) & "' r='" & IF ( [@pico], "5", "3" ) & "' fill='" & IF ( [@pico], "#f87171", "#0b1023" ) & "' stroke='" & IF ( [@pico], "#f87171", "#fbbf24" ) & "' stroke-width='2'/></g>"
			                & IF ( [@pico], "<text x='" & FORMAT ( [@x], "0" ) & "' y='" & FORMAT ( [@y] - 10, "0" ) & "' text-anchor='middle' font-size='10' font-weight='700' fill='#fca5a5' stroke='#0b1023' stroke-width='3' paint-order='stroke'>" & _nome & "</text>", "" ),
			        "", [@i], ASC
			    )
			RETURN
			    "<div class='card' style='grid-area:e'>
			        <div style='display:flex;justify-content:space-between;align-items:baseline'>
			            <div class='ctitle'>% de entregas atrasadas por mês</div>
			            <div class='sub'><span style='color:#34d399'>┅</span> meta: abaixo de " & FORMAT ( _meta, "0%" ) & "</div>
			        </div>"
			        & IF (
			            _n < 2,
			            "<div class='sub'>Selecione um período com pelo menos 2 meses.</div>",
			            "<svg viewBox='0 0 " & _W & " " & _H & "' style='flex:1;min-height:0;width:100%'>
			                <defs>
			                    <linearGradient id='gE' x1='0' y1='0' x2='0' y2='1'>
			                        <stop offset='0%' stop-color='#f87171' stop-opacity='0.45'/>
			                        <stop offset='100%' stop-color='#f87171' stop-opacity='0'/>
			                    </linearGradient>
			                </defs>"
			                & _grid
			                & "<line x1='" & _px & "' x2='" & ( _W - _px ) & "' y1='" & _yMeta & "' y2='" & _yMeta & "' stroke='#34d399' stroke-dasharray='5 4' opacity='0.7'/>"
			                & "<polygon points='" & _area & "' fill='url(#gE)'/>"
			                & "<polyline points='" & _line & "' fill='none' stroke='#fbbf24' stroke-width='2.5' stroke-linejoin='round'/>"
			                & _dots & _labels &
			            "</svg>"
			        )
			        & "</div>"
			
			```
		lineageTag: 24f18d06-8952-4fcc-840e-6300ca48eadd

	measure 'HTML Mapa Prazo' =
			
			VAR _estados =
			    DATATABLE (
			        "Sigla", STRING, "X", INTEGER, "Y", INTEGER, "Fonte", INTEGER, "Forma", STRING,
			        { { "SP", 254, 283, 9, "M212 286L220 280L230 262L239 257L250 259L250 262L252 261L253 263L254 261L267 259L269 262L271 274L276 275L274 284L276 286L276 290L286 288L291 286L293 288L297 288L296 290L291 292L292 296L285 298L285 300L281 299L270 304L262 310L259 314L258 311L255 311L256 308L248 307L249 304L245 299L245 293L242 289L235 289L222 284L212 286Z" },
